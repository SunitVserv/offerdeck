.tooltip {text-decoration: none; border-bottom:1px dotted #36c;color: #36c; outline: none;   font-family: 'Conv_Gotham-Light';}
/*For tooltip box*/
.close{background: url(../img/close_02.png) no-repeat 95% center;padding-right: 20px;border-bottom:none; cursor: pointer;}
div#mcTooltip {line-height:16px;border-width: 1px;   color:#333; border-color:#aeb3be;padding:10px 20px 0;font-size: 12px;font-family: Verdana, Arial;border-radius:5px; /*Rounded corners. N/A for IE 8 and below.*/
box-shadow: 0 1px 4px #AAAAAA; /*Drop shadow. N/A for IE 8 and below.*/}
div#mcTooltip, div.mcTooltipInner {background-color:#f4f6f9;}
/* For hyperlink within tooltip */
div#mcTooltip a {color:#36c; }
/*Close button. Available when sticky or overlay has been set to true, or is on iPhone, iPad, Android, BlackBerry, or IEMobile devices. */
div#mcttCloseButton {width:14px;height:14px;position:absolute;background-image:url(closeBtn.gif);cursor:pointer; overflow:hidden;top:12px; right:12px; left:auto;}
/* Only applies when overlay has been set to true or 1 */
div#mcOverlay {background-color: white;opacity:0.8; filter: alpha(opacity=80); display:none;top:0;left:0;width:100%;height: 100%;overflow:visible;z-index:4; }
/*Only available when calling by tooltip.ajax(...). It will be a spinning image indicating a request is in progress.*/
div#tooltipAjaxSpin {margin:20px 50px; background:transparent url(loading.gif) no-repeat center center; width:50px; height:30px; font-size:0;}
/*The settings below should remain unchanged*/
div#mcTooltipWrapper {position:absolute;visibility:hidden;overflow:visible;z-index:9999999999;top:0px;}
div#mcTooltip {float:left;border-style:solid;position:relative;overflow:hidden;}
div.mcTooltipInner {float:left;position:relative;width:auto;height:auto; font-family: 'Conv_Gotham-Light';}
