/**********************error message******************************/
.mes{}
.mes span:before{content:'';display:inline-block;width:15px;height:15px;float:left;font:14px fontAwesome;margin-right:5px;}

.mes{background: #fff;padding:7px 10px;border-radius:4px;position:relative;margin-top: 11px; width: -moz-fit-content;}
.mes:after, .mes:before { bottom: 100%; left:50px; border: solid transparent; content: " "; height: 0; width: 0; position: absolute; pointer-events: none; }
.mes:after { border-color: rgba(136, 183, 213, 0); border-bottom-color: #fff; border-width:6px; margin-left: -27px; }
