#haTooltip {background:#f4f5f9; border: 1px solid #aaa; border-radius: 5px; box-shadow: 0 0 5px rgba(0, 0, 0, 0.25); left: 100px; padding: 10px; position: absolute; top: 175px; display:none; color:#888;/* font-size:14px;*/ line-height:1.2; z-index:99999999; font-size:0.9em; max-width:250px;word-break:break-all; /*pointer-events:none;*/ }
#haTooltip p{font-size:1em; margin:0 0 7px;}
#haTooltip:after{content:''; position:absolute; width:9px; height:5px; margin-left:50%; left:-4px; bottom:-5px; z-index:1; background:url(../img/tooltip_arr1.png) no-repeat 0 0;}
#haTooltip.noArrow:after{background:none !important;}
#haTooltip.tt_bt:after{bottom:auto; top:-5px; background-image:url(../img/tooltip_arr2.png); content:'';}
