.mes.error span:before{content:'\f071'}
.mes.error{color:#a22a2a;border:1px solid #a22a2a;}
.mes.error:before{border-color: rgba(194, 225, 245, 0); border-bottom-color: #a22a2a;}

.mes.alert-info span:before{content:'\f06a'}
.mes.alert-info{color:#7c8597;border:1px solid #bec2cb;background:#f6f8fa;}
.mes.alert-info:before{border-color: rgba(194, 225, 245, 0); border-bottom-color: #bec2cb;}

.mes.cautionary span:before{content:'\f071'}
.mes.cautionary{color:#a57726;border:1px solid #a57726;}
.mes.cautionary:before{border-color: rgba(194, 225, 245, 0); border-bottom-color: #a57726;}

