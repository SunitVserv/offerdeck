/* traffic-settings*/
.test_postback, .validate_click_url, .validate_postback_url {
    border: 1px solid #6e3584;
    color: #6e3584;
    font-weight: 700;
    padding: 10px 10px 10px 10px;
    text-transform: uppercase;
}

.test-postback-closeBtn:before {
  content: "\f057";
  font-family: fontawesome;
  font-size: 38px;
}

.test-postback-closeBtn {
    border-radius: 50%; background: #fff;
    color: #000;
    cursor: pointer;
    font: bold 17px/25px open sans;
    height: 25px;
    padding: 0;
    position: absolute;
    right: 0;
    text-align: center;
    top: -10px;
    width: 25px;
    z-index: 1002;
}

.overlay-bg {
    background: rgba(0, 0, 0, 0.5) none repeat scroll 0 0;
    display: block;
    height: 100%;
    left: 0;
    overflow: auto;
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
}

#test-postback-bg.overlay-bg{display: none;}
.overlay-bg .overlay-content{position: relative;}
.overlay-bg .overlay-container{display: block !important; position: static; margin: 40px auto !important;}

.overlay-content {
    background: #fff none repeat scroll 0 0;
    border-radius: 4px;
    margin: 0 auto;
    padding: 20px 4%;
    position: relative;
    z-index: 9999;
    top: 70px;
}

.overlay-container {
    border-radius: 5px;
    display: none;
    max-width: 800px;
    position: fixed;
    z-index: 1001;
}

.overlay-container.test-postback-popup .formLayout dl dd input[type="text"] {
  min-width: 69%;
  max-width: 69%;
  padding: 8px;
  background: #fff;
}

#postback-info{
    display: inline-block;
}

.err_messages_postback:before, .err_messages_click:before {content: "\f071";font-family: fontawesome;padding-right: 10px;}
.err_messages_postback, .err_messages_click {color: red; display: none;}

.notif_messages_postback:before, .notif_messages_click:before {content: "\f00c";font-family: fontawesome;padding-right: 10px;font-size:14px;}
.notif_messages_postback, .notif_messages_click {color: green; display: none; margin-top: 10px;}
textarea:disabled {
    color: #ccc;
    font-style: italic !important;
    cursor: default;
}

 .lbl_uploadfile {
    width:59%;
    border: 1px solid #dbdbdb;
    position: relative;
}

.lbl_uploadfile label {
    font-style: italic;
    padding: 8px 10px;
    font-size: 12px;
    color: #a7a7a7;
    display: inline-block;
    box-sizing: border-box;
    font: 14px Conv_Gotham-Light;
    color: #828282;
    padding-top: 12px;
    display: block;
    cursor: default;    
}
.lbl_uploadfile label span.file_name {
    font-size: 1em;
    color: #a7a7a7;
    display: inline-block;
    font: 14px conv_gotham-book;
    vertical-align: middle;
    font-style: italic;
}

.lbl_uploadfile .butt-upload {
    padding-top: 7px;
    font: 12px Conv_Gotham-Book;
    position: absolute;
}

.butt-upload {
    background: #eaedf0;
    padding: 10px;
    color: #a2a3a5;
    font: 14px Conv_Gotham-Book;
    vertical-align: middle;
    text-align: center;
    cursor: pointer;
    box-shadow: -1px 1px 2px -1px rgba(0,0,0,0.15) inset;
    border: #dfe0e3 solid 1px;
    right: 1px;
    top: 1px;
    bottom: 1px;
}
.butt-upload:hover, .butt-upload:focus {
    background: #084384;
    color: #fff;
    border: 1px solid #084384;
}

