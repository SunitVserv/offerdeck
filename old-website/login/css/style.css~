#haTooltip > .arrow > em{border-color: transparent #aaa; border-bottom: 9px dashed transparent; border-top: 9px dashed transparent; border-right: 9px solid #aaa;}
#haTooltip > .arrow > b {border-color: transparent #f4f5f9; margin-top: -18px; margin-left: 1px; border-bottom: 9px dashed transparent; border-top: 9px dashed transparent; border-right: 9px solid #f4f5f9;}

#haTooltip hr{margin: 3px 0; border: 0; border-top: #fff 1px solid; border-bottom: #ddd 1px solid;}

.tooltip_data{display:none;}

.tt_parent_data{position:relative;}
.tt_parent_data > .tt_data{position:absolute; top:0; left:0; right:0; bottom: 0; z-index:1;}

.tooltip-help{display:none !important; pointer-events:none;}

#haTooltipClose{position:absolute; top:3px; right:3px; color:#000; width:15px; height:18px; background:none; border:0;}


