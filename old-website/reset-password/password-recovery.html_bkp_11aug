
<!DOCTYPE html>
<html>
<head>
	<link rel="icon" type="image/png" href="https://dashboard.offerdeck.com/favicon-16x16.png" sizes="16x16">
        <link rel="icon" type="image/png" href="https://dashboard.offerdeck.com/favicon-24x24.png" sizes="24x24">
        <link rel="icon" type="image/png" href="https://dashboard.offerdeck.com/favicon-32x32.png" sizes="32x32">
        <title>Offerdeck</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link href="https://dashboard.offerdeck.com/css/style.css" rel="stylesheet" media="screen">
	<script src="https://dashboard.offerdeck.com/js/jquery-1.10.1.min.js"></script>
	<script src="https://dashboard.offerdeck.com/js/jquery.cookie.min.js"></script>
	<script src="https://dashboard.offerdeck.com/js/config.js"></script>
     <script src="https://dashboard.offerdeck.com/js/libs/ejs.js"></script>
	<script src="https://dashboard.offerdeck.com/js/login.js"></script>
	<!--[if IE]>
    <script type="text/javascript" src="http://cdnjs.cloudflare.com/ajax/libs/jquery-ajaxtransport-xdomainrequest/1.0.2/jquery.xdomainrequest.min.js"></script>
	<![endif]-->
	<script src="https://dashboard.offerdeck.com/js/common.js"></script>
	<script src="https://dashboard.offerdeck.com/module-js/utility.js"></script>
</head>
<body class="create-password-page">
<div class="clear"></div>
<section class="view container">
<section class="inner-cont apps-site new-app">
  <div class="login-wraper">
		<div id="invalid_err" class="err_messages">Invalid password reset URL.</div>
    <div class="c1">
      <form id="frm-recover" method="POST" autocomplete="off">
      			<h2>Create New Password</h2>
				<div class="login-form">
					<dl>
						<dt><label>Enter Password:</label></dt>
						<dd><input name="recovery_id" type="hidden" value="" /><input name="newpassword" type="password" value="" /></dd>
					</dl>
					<dl>
						<dt><label>Confirm Password:</label></dt>
						<dd><input name="confirmpassword" type="password" value="" /></dd>
					</dl>
					<div id="reset_err" class="err_messages"></div>
					<div id="reset_msg" class="notif_messages"></div>
					<button type="submit" class="btn">Submit</button>
				</div>
			</form>
    </div>
		
		<div id="forgot-password" class="overlay-box">
			<h1>Forgot Password</h1>
			<div class="forgot-form">
				<dl>
					<dt><label>Email Address:</label></dt>
					<dd><input id="forgot-email" type="text"></dd>
				</dl>
				<button id="btn-forgot-password" type="button" class="btn">SUBMIT</button><span class="loader">&nbsp;&nbsp;&nbsp;&nbsp;</span>
				<div id="forgot_msg" class="notif_messages"></div>
				<div id="forgot_err" class="err_messages"></div>
			</div>
			<div class="closeBtn"></div>
		</div>
  </div>
	</section>
</section>
<div id="footer"></div>
<script>
    //including footer
            $(document).ready(function () {
                var data = {};
                var footer = new EJS({url: 'https://dashboard.offerdeck.com/templates/common/footer.ejs'}).render(data);
                $('#footer').html(footer);
            });
	$(document).ready(function () {
		var recovery_id = getParameterByName('id');
		var frm = document.getElementById('frm-recover');
		
		if (recovery_id) {
			frm.elements['recovery_id'].value = recovery_id;
			
			frm.onsubmit = function () {
				var self = this;
				$('.notif_messages, .err_messages').hide();
				
				var new_pass = self.elements['newpassword'];
				var conf_pass = self.elements['confirmpassword'];
				var recovery_id = self.elements['recovery_id'];
				
				if (new_pass.value.length < 6) {
					var message = 'Password must contain minimum 6 characters';
					$('#reset_err').html(message).show();
					new_pass.focus();
					return false;
				}
				
				if (new_pass.value != conf_pass.value) {
					var message = 'Confirm password does not match with new password';
					$('#reset_err').html(message).show();
					conf_pass.focus();
					return false;
				}
				
				var post_data = {
					recovery_id: recovery_id.value,
					newpassword: new_pass.value,
					confirmpassword: conf_pass.value
				}
				
				var url = api_config.base_url + api_config.reset_password;
				
				$.ajax({
					url: url,
					type: 'post',
					data: JSON.stringify(post_data),
					contentType: "application/json",
					dataType: 'json',
					success: function (data) {
						if (data.status == 153) {
							 var message = 'Password has been reset, you can now <a href="' + api_config.login_url + '">login</a>.';
							 $('#reset_msg').html(message).show();
							//location.href = api_config.login_url + '?action=reset';
						} else if (data.status == 160) {
							var message = 'You have already reset your password previously. If you wish to reset again, Click <a onclick=\'overlayBox("forgot-password");\' href="javascript: void(0);">here</a>';
							$('#reset_err').html(message).show();
						} else if (data.status == 100) {
							var message = 'Please fill mandatory fields';
							$('#reset_err').html(message).show();
						} else if (data.status == 176) {
							var message = 'Password should contain atleast '+ password_complexity.length + ' characters!';
							$('#reset_err').html(message).show();
						} else if (data.status == 177) {
							var message = 'Password should contain atleast one alphabet, one digit & one special character!';
							$('#reset_err').html(message).show();
						}
					}
				});
				
				return false;
			}
			
		} else {
			$(frm).hide();
			$('#invalid_err').show();
		}
	});
</script>
</body>
</html>

